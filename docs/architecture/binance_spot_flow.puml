@startuml BinanceSpotFlow
title Current Binance Spot Testnet flow

skinparam monochrome true
skinparam defaultFontName Courier
skinparam shadowing false

actor "Runtime" as Runtime
participant "Binance module" as Binance
participant "Spot Testnet REST API" as API
participant "Account" as Account
participant "Order Book" as Book
participant "Matching Engine" as Engine

Runtime -> Binance : run()
Binance -> API : Signed GET account
API -> Account : Load permissions and balances
Account --> API : Account state
API --> Binance : AccountInfo

alt can_trade
  Binance -> API : GET depth (BTCUSDT, 100 levels)
  API -> Book : Load bids and asks
  Book --> API : Depth snapshot
  API --> Binance : OrderBook JSON
  Binance -> Binance : Parse Decimal values\nfilter and select best quote
  Binance -> API : Signed LIMIT FOK order
  API -> Engine : Match immediately or cancel
  Engine --> API : Order result
  API --> Binance : JSON response
else trading disabled
  Binance -> Binance : Log and stop
end

@enduml
